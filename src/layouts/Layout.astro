---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | The CI Team</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#2EA44F" />
    
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-primary-50">
    <header class="bg-white border-b border-primary-200">
      <nav class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-xl font-semibold text-primary-900">The CI Team</a>
          <div class="hidden md:flex space-x-6">
            <a href="/services" class="text-primary-600 hover:text-accent">Services</a>
            <a href="/about" class="text-primary-600 hover:text-accent">About</a>
            <a href="/contact" class="text-primary-600 hover:text-accent">Contact</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-white border-t border-primary-200 mt-16">
      <div class="container mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold text-primary-900 mb-4">The CI Team</h3>
            <p class="text-primary-600">Expert CI/CD and infrastructure solutions for modern development teams.</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-primary-900 mb-4">Quick Links</h3>
            <ul class="space-y-2">
              <li><a href="/services" class="text-primary-600 hover:text-accent">Services</a></li>
              <li><a href="/about" class="text-primary-600 hover:text-accent">About</a></li>
              <li><a href="/contact" class="text-primary-600 hover:text-accent">Contact</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-primary-900 mb-4">Contact</h3>
            <p class="text-primary-600">Email: contact@the-ci-team.com</p>
          </div>
        </div>
        <div class="border-t border-primary-200 mt-8 pt-8 text-center text-primary-600">
          <p>&copy; {new Date().getFullYear()} The CI Team. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html> 