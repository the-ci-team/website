---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services">
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-center mb-12">Our Services</h1>
      
      <div class="max-w-4xl mx-auto space-y-16">
        <div class="bg-white p-8 rounded-lg shadow-md">
          <h2 class="text-2xl font-bold mb-6">CI Process Review</h2>
          <p class="text-gray-600 mb-6">
            Our comprehensive CI process review helps organizations optimize their continuous integration pipeline for maximum efficiency and reliability.
          </p>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-xl font-semibold mb-4">Benefits</h3>
              <ul class="space-y-2 text-gray-600">
                <li>✓ Release more frequently with confidence</li>
                <li>✓ Minimize CI system downtime</li>
                <li>✓ Accelerate development cycles</li>
                <li>✓ Optimize resource utilization</li>
                <li>✓ Reduce operational costs</li>
              </ul>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-4">Our Approach</h3>
              <ul class="space-y-2 text-gray-600">
                <li>✓ Comprehensive pipeline analysis</li>
                <li>✓ Performance benchmarking</li>
                <li>✓ Best practices implementation</li>
                <li>✓ Tooling recommendations</li>
                <li>✓ Team training and support</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md">
          <h2 class="text-2xl font-bold mb-6">Mac/iOS CI and Infrastructure</h2>
          <p class="text-gray-600 mb-6">
            Specialized solutions for teams developing Apple platform applications, ensuring reliable and efficient CI/CD processes.
          </p>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-xl font-semibold mb-4">Solutions</h3>
              <ul class="space-y-2 text-gray-600">
                <li>✓ Apple hardware provisioning</li>
                <li>✓ Virtualization with Anka/Tart</li>
                <li>✓ Infrastructure setup and maintenance</li>
                <li>✓ Performance optimization</li>
                <li>✓ Security hardening</li>
              </ul>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-4">Capabilities</h3>
              <ul class="space-y-2 text-gray-600">
                <li>✓ Multi-platform testing</li>
                <li>✓ Automated provisioning</li>
                <li>✓ Scalable infrastructure</li>
                <li>✓ Monitoring and alerting</li>
                <li>✓ Disaster recovery</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md">
          <h2 class="text-2xl font-bold mb-6">Linux/Android Solutions</h2>
          <p class="text-gray-600 mb-6">
            Comprehensive CI/CD solutions for Android and Linux-based development, optimized for performance and reliability.
          </p>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-xl font-semibold mb-4">Services</h3>
              <ul class="space-y-2 text-gray-600">
                <li>✓ Gradle Enterprise integration</li>
                <li>✓ Cloud emulator setup</li>
                <li>✓ Build optimization</li>
                <li>✓ Test automation</li>
                <li>✓ Performance monitoring</li>
              </ul>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-4">Features</h3>
              <ul class="space-y-2 text-gray-600">
                <li>✓ Parallel test execution</li>
                <li>✓ Build caching</li>
                <li>✓ Resource optimization</li>
                <li>✓ Automated scaling</li>
                <li>✓ Security compliance</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md">
          <h2 class="text-2xl font-bold mb-6">Automation and Tooling</h2>
          <p class="text-gray-600 mb-6">
            Streamline your development processes with our automation and tooling solutions, designed to enhance productivity and reliability.
          </p>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-xl font-semibold mb-4">Offerings</h3>
              <ul class="space-y-2 text-gray-600">
                <li>✓ GitOps implementation</li>
                <li>✓ Process automation</li>
                <li>✓ Tooling review</li>
                <li>✓ Workflow optimization</li>
                <li>✓ Integration services</li>
              </ul>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-4">Benefits</h3>
              <ul class="space-y-2 text-gray-600">
                <li>✓ Reduced manual intervention</li>
                <li>✓ Improved consistency</li>
                <li>✓ Faster deployments</li>
                <li>✓ Better visibility</li>
                <li>✓ Enhanced security</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout> 