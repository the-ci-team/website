---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-center mb-12">About The CI Team</h1>
        
        <div class="bg-white p-8 rounded-lg shadow-md mb-12">
          <h2 class="text-2xl font-bold mb-6">Our Story</h2>
          <p class="text-gray-600 mb-6">
            The CI Team was founded by industry veterans with over 30 years of combined experience in banking and enterprise environments. We understand the unique challenges that large organizations face when implementing and maintaining CI/CD systems.
          </p>
          <p class="text-gray-600">
            Our mission is to help teams release more often, reduce CI outages, and move faster with confidence. We achieve this through our deep expertise in CI/CD processes, infrastructure optimization, and automation.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8 rounded-lg shadow-md">
            <h2 class="text-2xl font-bold mb-6">Our Expertise</h2>
            <ul class="space-y-4 text-gray-600">
              <li class="flex items-start">
                <span class="text-primary-600 mr-2">✓</span>
                <span>Extensive experience in financial services and enterprise environments</span>
              </li>
              <li class="flex items-start">
                <span class="text-primary-600 mr-2">✓</span>
                <span>Deep knowledge of CI/CD best practices and tools</span>
              </li>
              <li class="flex items-start">
                <span class="text-primary-600 mr-2">✓</span>
                <span>Expertise in Mac/iOS and Linux/Android CI infrastructure</span>
              </li>
              <li class="flex items-start">
                <span class="text-primary-600 mr-2">✓</span>
                <span>Proven track record in process optimization and automation</span>
              </li>
            </ul>
          </div>
          
          <div class="bg-white p-8 rounded-lg shadow-md">
            <h2 class="text-2xl font-bold mb-6">Our Approach</h2>
            <ul class="space-y-4 text-gray-600">
              <li class="flex items-start">
                <span class="text-primary-600 mr-2">✓</span>
                <span>Comprehensive analysis of existing CI/CD processes</span>
              </li>
              <li class="flex items-start">
                <span class="text-primary-600 mr-2">✓</span>
                <span>Customized solutions tailored to your specific needs</span>
              </li>
              <li class="flex items-start">
                <span class="text-primary-600 mr-2">✓</span>
                <span>Hands-on implementation and support</span>
              </li>
              <li class="flex items-start">
                <span class="text-primary-600 mr-2">✓</span>
                <span>Continuous improvement and optimization</span>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md mt-12">
          <h2 class="text-2xl font-bold mb-6">Why Choose Us</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="text-center">
              <h3 class="text-xl font-semibold mb-2">Experience</h3>
              <p class="text-gray-600">30+ years combined experience in enterprise environments</p>
            </div>
            <div class="text-center">
              <h3 class="text-xl font-semibold mb-2">Expertise</h3>
              <p class="text-gray-600">Deep knowledge across multiple platforms and technologies</p>
            </div>
            <div class="text-center">
              <h3 class="text-xl font-semibold mb-2">Results</h3>
              <p class="text-gray-600">Proven track record of successful implementations</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout> 